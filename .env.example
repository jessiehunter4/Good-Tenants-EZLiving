# Copy to .env.local and fill in. .env.local is gitignored; keep it that way.
#
# VITE_-prefixed variables are compiled into the browser bundle. Only put values
# there that are safe to publish. Everything below the fold is server-side only.

# --- Browser -----------------------------------------------------------------

# Platform Supabase project.
VITE_SUPABASE_URL=
# New-format publishable key (sb_publishable_...). Safe in the bundle because
# every table carries RLS and explicit grants — not because the key is secret.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Local sign-in bypass. "1" enables it, and only on a dev server; a production
# build refuses it whatever this says. See src/lib/devBypass.ts.
VITE_DEV_BYPASS_AUTH=
# tenant | agent | landlord | admin
VITE_DEV_BYPASS_ROLE=

# --- Server-side only --------------------------------------------------------
# Never give any of these a VITE_ prefix.

SUPABASE_PROJECT_REF=
# Secret key (sb_secret_...). Bypasses every policy in the project.
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=

# Postgres connection for migrations. The direct host db.<ref>.supabase.co is
# IPv6-only; use the session pooler string from Dashboard → Connect on an
# IPv4-only network.
DATABASE_URL=
